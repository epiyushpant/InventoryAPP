using Inventory.Models;
using Microsoft.Data.SqlClient;
using Microsoft.EntityFrameworkCore;

namespace Inventory.Data
{
    public class StockMovementRepository
    {
        private readonly ApplicationDbContext _context;

        public StockMovementRepository(ApplicationDbContext context)
        {
            _context = context;
        }

        public async Task<List<StockMovement>> GetAllAsync()
        {
            return await _context.StockMovements
                .FromSqlRaw("EXEC dbo.spGetStockMovements")
                .ToListAsync();
        }

        public async Task<StockMovement?> GetByIdAsync(int id)
        {
            var param = new SqlParameter("@MovementID", id);
            return await _context.StockMovements
                .FromSqlRaw("EXEC dbo.spGetStockMovements @MovementID", param)
                .AsNoTracking()
                .FirstOrDefaultAsync();
        }

        public async Task<int> CreateAsync(StockMovement movement)
        {
            var productParam = new SqlParameter("@ProductID", movement.ProductID ?? (object)DBNull.Value);
            var typeParam = new SqlParameter("@MovementType", movement.MovementType ?? (object)DBNull.Value);
            var changeParam = new SqlParameter("@QuantityChange", movement.QuantityChange ?? (object)DBNull.Value);
            var dateParam = new SqlParameter("@MovementDate", movement.MovementDate ?? (object)DBNull.Value);
            var refParam = new SqlParameter("@Reference", movement.Reference ?? (object)DBNull.Value);
            var idParam = new SqlParameter
            {
                ParameterName = "@MovementID",
                SqlDbType = System.Data.SqlDbType.Int,
                Direction = System.Data.ParameterDirection.Output
            };

            await _context.Database.ExecuteSqlRawAsync(
                "EXEC dbo.spInsertStockMovement @ProductID, @MovementType, @QuantityChange, @MovementDate, @Reference",
                productParam, typeParam, changeParam, dateParam, refParam);

            return (int)idParam.Value;
        }

        public async Task UpdateAsync(StockMovement movement)
        {
            var idParam = new SqlParameter("@MovementID", movement.MovementID);
            var productParam = new SqlParameter("@ProductID", movement.ProductID ?? (object)DBNull.Value);
            var typeParam = new SqlParameter("@MovementType", movement.MovementType ?? (object)DBNull.Value);
            var changeParam = new SqlParameter("@QuantityChange", movement.QuantityChange ?? (object)DBNull.Value);
            var dateParam = new SqlParameter("@MovementDate", movement.MovementDate ?? (object)DBNull.Value);
            var refParam = new SqlParameter("@Reference", movement.Reference ?? (object)DBNull.Value);

            await _context.Database.ExecuteSqlRawAsync(
                "EXEC dbo.spUpdateStockMovement @MovementID, @ProductID, @MovementType, @QuantityChange, @MovementDate, @Reference",
                idParam, productParam, typeParam, changeParam, dateParam, refParam);
        }

        public async Task DeleteAsync(int id)
        {
            var idParam = new SqlParameter("@MovementID", id);
            await _context.Database.ExecuteSqlRawAsync(
                "EXEC dbo.spDeleteStockMovement @MovementID", idParam);
        }
    }
}
