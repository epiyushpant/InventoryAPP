using Inventory.Models;
using Microsoft.Data.SqlClient;
using Microsoft.EntityFrameworkCore;

namespace Inventory.Data
{
    public class SaleDetailRepository
    {
        private readonly ApplicationDbContext _context;

        public SaleDetailRepository(ApplicationDbContext context)
        {
            _context = context;
        }

        public async Task<List<SaleDetail>> GetAllAsync()
        {
            return await _context.SaleDetails
                .FromSqlRaw("EXEC dbo.spGetSaleDetails")
                .ToListAsync();
        }

        public async Task<SaleDetail?> GetByIdAsync(int id)
        {
            var param = new SqlParameter("@SaleDetailID", id);
            return await _context.SaleDetails
                .FromSqlRaw("EXEC dbo.spGetSaleDetails @SaleDetailID", param)
                .AsNoTracking()
                .FirstOrDefaultAsync();
        }

        public async Task<int> CreateAsync(SaleDetail detail)
        {
            var saleParam = new SqlParameter("@SaleID", detail.SaleID ?? (object)DBNull.Value);
            var productParam = new SqlParameter("@ProductID", detail.ProductID ?? (object)DBNull.Value);
            var quantityParam = new SqlParameter("@Quantity", detail.Quantity);
            var priceParam = new SqlParameter("@UnitPrice", detail.UnitPrice);
            var idParam = new SqlParameter
            {
                ParameterName = "@SaleDetailID",
                SqlDbType = System.Data.SqlDbType.Int,
                Direction = System.Data.ParameterDirection.Output
            };

            await _context.Database.ExecuteSqlRawAsync(
                "EXEC dbo.spInsertSaleDetail @SaleID, @ProductID, @Quantity, @UnitPrice",
                saleParam, productParam, quantityParam, priceParam, idParam);

            return (int?)idParam.Value ?? 0;
        }

        public async Task UpdateAsync(SaleDetail detail)
        {
            var idParam = new SqlParameter("@SaleDetailID", detail.SaleDetailID);
            var saleParam = new SqlParameter("@SaleID", detail.SaleID ?? (object)DBNull.Value);
            var productParam = new SqlParameter("@ProductID", detail.ProductID ?? (object)DBNull.Value);
            var quantityParam = new SqlParameter("@Quantity", detail.Quantity);
            var priceParam = new SqlParameter("@UnitPrice", detail.UnitPrice);

            await _context.Database.ExecuteSqlRawAsync(
                "EXEC dbo.spUpdateSaleDetail @SaleDetailID, @SaleID, @ProductID, @Quantity, @UnitPrice",
                idParam, saleParam, productParam, quantityParam, priceParam);
        }

        public async Task DeleteAsync(int id)
        {
            var idParam = new SqlParameter("@SaleDetailID", id);
            await _context.Database.ExecuteSqlRawAsync(
                "EXEC dbo.spDeleteSaleDetail @SaleDetailID", idParam);
        }
    }
}
