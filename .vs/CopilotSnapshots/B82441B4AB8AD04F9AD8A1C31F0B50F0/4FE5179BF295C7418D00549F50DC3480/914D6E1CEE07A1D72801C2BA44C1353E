using Inventory.Data;
using Inventory.Models;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Inventory.Controllers
{
    [Route("api/[controller]")]
    [ApiController]
    [Authorize]
    public class InventoriesController : ControllerBase
    {
        private readonly InventoryRepository _repo;

        public InventoriesController(InventoryRepository repo)
        {
            _repo = repo;
        }

        [HttpGet]
        public async Task<ActionResult<IEnumerable<Models.Inventory>>> GetInventories()
        {
            var inventories = await _repo.GetAllAsync();
            return Ok(inventories);
        }

        [HttpGet("{id}")]
        public async Task<ActionResult<Models.Inventory>> GetInventory(int id)
        {
            var inventory = await _repo.GetByIdAsync(id);
            if (inventory == null)
                return NotFound();
            return Ok(inventory);
        }

        [HttpPost]
        public async Task<ActionResult<Models.Inventory>> CreateInventory(Models.Inventory inventory)
        {
            var newId = await _repo.CreateAsync(inventory);
            inventory.InventoryID = newId;
            return CreatedAtAction(nameof(GetInventory), new { id = newId }, inventory);
        }

        [HttpPut("{id}")]
        public async Task<IActionResult> UpdateInventory(int id, Models.Inventory inventory)
        {
            if (id != inventory.InventoryID)
                return BadRequest();

            await _repo.UpdateAsync(inventory);
            return NoContent();
        }

        [HttpDelete("{id}")]
        public async Task<IActionResult> DeleteInventory(int id)
        {
            await _repo.DeleteAsync(id);
            return NoContent();
        }
    }
}
