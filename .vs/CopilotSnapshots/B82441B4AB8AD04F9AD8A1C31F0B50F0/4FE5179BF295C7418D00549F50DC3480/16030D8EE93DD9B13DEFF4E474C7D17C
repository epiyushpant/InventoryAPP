using Inventory.Data;
using Inventory.Models;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Inventory.Controllers
{
    [Route("api/[controller]")]
    [ApiController]
    [Authorize]
    public class PurchaseOrderDetailsController : ControllerBase
    {
        private readonly PurchaseOrderDetailRepository _repo;

        public PurchaseOrderDetailsController(PurchaseOrderDetailRepository repo)
        {
            _repo = repo;
        }

        [HttpGet]
        public async Task<ActionResult<IEnumerable<PurchaseOrderDetail>>> GetPurchaseOrderDetails()
        {
            var details = await _repo.GetAllAsync();
            return Ok(details);
        }

        [HttpGet("{id}")]
        public async Task<ActionResult<PurchaseOrderDetail>> GetPurchaseOrderDetail(int id)
        {
            var detail = await _repo.GetByIdAsync(id);
            if (detail == null)
                return NotFound();
            return Ok(detail);
        }

        [HttpPost]
        public async Task<ActionResult<PurchaseOrderDetail>> CreatePurchaseOrderDetail(PurchaseOrderDetail detail)
        {
            var newId = await _repo.CreateAsync(detail);
            detail.PODetailID = newId;
            return CreatedAtAction(nameof(GetPurchaseOrderDetail), new { id = newId }, detail);
        }

        [HttpPut("{id}")]
        public async Task<IActionResult> UpdatePurchaseOrderDetail(int id, PurchaseOrderDetail detail)
        {
            if (id != detail.PODetailID)
                return BadRequest();

            await _repo.UpdateAsync(detail);
            return NoContent();
        }

        [HttpDelete("{id}")]
        public async Task<IActionResult> DeletePurchaseOrderDetail(int id)
        {
            await _repo.DeleteAsync(id);
            return NoContent();
        }
    }
}
