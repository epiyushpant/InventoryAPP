using Inventory.Data;
using Inventory.Models;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace Inventory.Controllers
{
    [Route("api/[controller]")]
    [ApiController]
    [Authorize]
    public class SaleDetailsController : ControllerBase
    {
        private readonly SaleDetailRepository _repo;

        public SaleDetailsController(SaleDetailRepository repo)
        {
            _repo = repo;
        }

        [HttpGet]
        public async Task<ActionResult<IEnumerable<SaleDetail>>> GetSaleDetails()
        {
            var details = await _repo.GetAllAsync();
            return Ok(details);
        }

        [HttpGet("{id}")]
        public async Task<ActionResult<SaleDetail>> GetSaleDetail(int id)
        {
            var detail = await _repo.GetByIdAsync(id);
            if (detail == null)
                return NotFound();
            return Ok(detail);
        }

        [HttpPost]
        public async Task<ActionResult<SaleDetail>> CreateSaleDetail(SaleDetail detail)
        {
            var newId = await _repo.CreateAsync(detail);
            detail.SaleDetailID = newId;
            return CreatedAtAction(nameof(GetSaleDetail), new { id = newId }, detail);
        }

        [HttpPut("{id}")]
        public async Task<IActionResult> UpdateSaleDetail(int id, SaleDetail detail)
        {
            if (id != detail.SaleDetailID)
                return BadRequest();

            await _repo.UpdateAsync(detail);
            return NoContent();
        }

        [HttpDelete("{id}")]
        public async Task<IActionResult> DeleteSaleDetail(int id)
        {
            await _repo.DeleteAsync(id);
            return NoContent();
        }
    }
}
