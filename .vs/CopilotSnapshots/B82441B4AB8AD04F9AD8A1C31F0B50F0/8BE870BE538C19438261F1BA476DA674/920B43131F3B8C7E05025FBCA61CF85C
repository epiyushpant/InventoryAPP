using Inventory.Models;
using Microsoft.Data.SqlClient;
using Microsoft.EntityFrameworkCore;

namespace Inventory.Data
{
    public class CategoryRepository
    {
        private readonly ApplicationDbContext _context;

        public CategoryRepository(ApplicationDbContext context)
        {
            _context = context;
        }

        public async Task<List<Category>> GetAllAsync()
        {
            return await _context.Categories
                .FromSqlRaw("EXEC dbo.spGetCategories")
                .ToListAsync();
        }

        public async Task<Category?> GetByIdAsync(int id)
        {
            var param = new SqlParameter("@CategoryID", id);
            return await _context.Categories
                .FromSqlRaw("EXEC GetCategoryById @CategoryID", param)
                .AsNoTracking()
                .FirstOrDefaultAsync();
        }

        public async Task<int> CreateAsync(Category category)
        {
            var nameParam = new SqlParameter("@CategoryName", category.CategoryName);
            var descParam = new SqlParameter("@Description", category.Description ?? (object)DBNull.Value);
            var idParam = new SqlParameter
            {
                ParameterName = "@CategoryID",
                SqlDbType = System.Data.SqlDbType.Int,
                Direction = System.Data.ParameterDirection.Output
            };

            // Call the stored procedure dbo.spInsertCategory
            await _context.Database.ExecuteSqlRawAsync(
                "EXEC dbo.spInsertCategory @CategoryName, @Description, @CategoryID OUT",
                nameParam, descParam, idParam);

            return (int)idParam.Value;
        }

        public async Task UpdateAsync(Category category)
        {
            var idParam = new SqlParameter("@CategoryID", category.CategoryID);
            var nameParam = new SqlParameter("@CategoryName", category.CategoryName);
            var descParam = new SqlParameter("@Description", category.Description ?? (object)DBNull.Value);

            await _context.Database.ExecuteSqlRawAsync(
                "EXEC UpdateCategory @CategoryID, @CategoryName, @Description",
                idParam, nameParam, descParam);
        }

        public async Task DeleteAsync(int id)
        {
            var idParam = new SqlParameter("@CategoryID", id);
            await _context.Database.ExecuteSqlRawAsync(
                "EXEC DeleteCategory @CategoryID", idParam);
        }
    }
}
